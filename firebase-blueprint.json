{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile with personal cookbook and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "maxLength": 100, "description": "User's display name" },
        "email": { "type": "string", "maxLength": 150, "description": "User's email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "Avatar photo URL" },
        "favoriteRecipeIds": { "type": "array", "description": "List of favorite recipe IDs" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["uid", "email"]
    },
    "recipes": {
      "title": "Recipe",
      "description": "User-contributed and community recipes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique Recipe ID" },
        "title": { "type": "string", "maxLength": 120, "description": "Recipe title" },
        "category": { "type": "string", "maxLength": 50, "description": "Recipe category" },
        "prepTime": { "type": "string", "maxLength": 50, "description": "Preparation time" },
        "cookTime": { "type": "string", "maxLength": 50, "description": "Cooking time" },
        "servings": { "type": "number", "description": "Number of servings" },
        "difficulty": { "type": "string", "maxLength": 30, "description": "Difficulty level" },
        "ingredients": { "type": "array", "description": "Array of ingredient strings" },
        "instructions": { "type": "array", "description": "Array of preparation step strings" },
        "authorId": { "type": "string", "maxLength": 128, "description": "UID of recipe creator" },
        "authorName": { "type": "string", "maxLength": 100, "description": "Name of recipe creator" },
        "likesCount": { "type": "number", "description": "Total number of favorites/likes" },
        "imageUrl": { "type": "string", "maxLength": 500, "description": "Image URL" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["title", "category", "authorId"]
    },
    "shoppingItems": {
      "title": "Shopping List Item",
      "description": "User grocery shopping list item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Item ID" },
        "name": { "type": "string", "maxLength": 100, "description": "Item name" },
        "amount": { "type": "string", "maxLength": 50, "description": "Amount or quantity" },
        "completed": { "type": "boolean", "description": "Whether item is purchased" },
        "userId": { "type": "string", "maxLength": 128, "description": "User UID who owns this item" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["name", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "Individual user document containing profile and settings"
    },
    "/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/recipes" },
      "description": "Collection of shared community recipes"
    },
    "/users/{userId}/shoppingItems/{itemId}": {
      "schema": { "$ref": "#/entities/shoppingItems" },
      "description": "User specific private shopping list items"
    }
  }
}
